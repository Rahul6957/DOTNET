    <a asp-controller="Orders" asp-action="Checkout"> Proceed to Checkout </a>|
    <a asp-controller="Cart" asp-action="Clear"> Clear Cart  </a> |
    <a asp-controller="Customer" asp-action="CustomerDashboard"> Back to Dashboard </a>

