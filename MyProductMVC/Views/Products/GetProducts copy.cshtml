@model List<products.models.Product>
@using products.models;
@{
    //models namespace .class name
}


@{ ViewData["Title"] = "Rahul"; }

<h3>Product list</h3>
<table border="1" cellpadding="8">
<tr>
    <th>Id</th> <th>Name</th> <th>Price</th> <th>Actions</th>
</tr>

@foreach(var product in Model)
{
     <tr>
            <td>@product.id</td>
            <td>@product.Name</td>
            <td>@product.price</td> 
    </tr>
}
</table>